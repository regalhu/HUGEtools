:host{display:block;position:sticky;top:0;z-index:99}.home-bar{padding:12rpx 28rpx;background:rgba(245,245,247,.97);border-bottom:1rpx solid rgba(0,0,0,.05)}.home-button{display:inline-flex;align-items:center;gap:10rpx;margin:0;padding:0 16rpx 0 0;min-height:64rpx;line-height:1;background:transparent;color:#165c49;font-size:27rpx;font-weight:600;border:0}.home-button::after{border:0}.back-arrow{font-size:52rpx;font-weight:400;line-height:1;margin-top:-4rpx}
