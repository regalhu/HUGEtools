page{background:#f5f5f7;color:#1d1d1f}.home{padding:30rpx 34rpx calc(48rpx + env(safe-area-inset-bottom));font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.brand-row{display:flex;align-items:center;justify-content:space-between}.brand{display:flex;gap:18rpx;align-items:center}.brand-logo{width:190rpx;height:138rpx;border-radius:16rpx}.brand-name{font-size:27rpx;font-weight:600;letter-spacing:-.6rpx}.brand-en{margin-top:5rpx;font-size:16rpx;letter-spacing:3rpx;color:#86868b;font-weight:600}.version{border:1rpx solid #dedee2;border-radius:30rpx;color:#6e6e73;padding:8rpx 17rpx;font-size:21rpx;font-weight:500}.hero{padding:57rpx 0 37rpx}.eyebrow{color:#007d7b;font-size:23rpx;font-weight:600;letter-spacing:2rpx;margin-bottom:19rpx}.headline{font-size:61rpx;line-height:1.18;letter-spacing:-2.8rpx;font-weight:650}.headline-muted{color:#818187;margin-top:6rpx}.hero-caption{color:#6e6e73;font-size:25rpx;line-height:1.7;margin-top:24rpx}.nowrap{white-space:nowrap}.search-box{display:flex;align-items:center;height:90rpx;background:#e9e9ed;border-radius:23rpx;padding:0 23rpx;gap:15rpx}.search-icon{font-size:40rpx;color:#717178;line-height:1}.search-input{flex:1;min-width:0;font-size:24rpx;height:86rpx}.search-placeholder{color:#8a8a90}.clear{background:none;border:0;width:44rpx;height:54rpx;line-height:52rpx;padding:0;color:#777;font-size:34rpx}.clear::after,.tool-card::after,.quick-item::after{border:0}.privacy{display:flex;align-items:center;justify-content:center;gap:11rpx;color:#8a8a90;font-size:20rpx;padding:21rpx 0 7rpx}.privacy-dot{width:8rpx;height:8rpx;background:#009d99;border-radius:50%}.section{margin-top:42rpx}.section-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx}.section-title{font-size:33rpx;font-weight:600;letter-spacing:-1rpx}.section-subtitle{font-size:22rpx;line-height:1.6;color:#86868b;margin-top:5rpx}.section-count{color:#a1a1a6;font-size:23rpx;font-weight:500}.tool-grid{display:grid;grid-te