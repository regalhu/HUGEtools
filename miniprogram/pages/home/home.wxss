x;line-height:1.8}.empty-title{font-size:29rpx;color:#3a3a3c;font-weight:600;margin-bottom:8rpx}.empty button{margin-top:25rpx;background:#007d7b;color:#fff;border-radius:20rpx;font-size:25rpx;padding:8rpx 24rpx}@media(min-width:700px){.home{max-width:900px;margin:0 auto}.tool-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
