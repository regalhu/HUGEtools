page{background:#f6f5f0;color:#193b32}.page{padding:28rpx 26rpx 70rpx}.hero{padding:28rpx 4rpx}.kicker{font-size:22rpx;color:#738273}.title{font-size:46rpx;font-weight:700;margin:18rpx 0}.note{font-size:25rpx;line-height:1.7;color:#647168;word-break:break-all}.card{background:#fff;border:1rpx solid #e0e3d9;border-radius:24rpx;padding:26rpx;margin:22rpx 0}.heading{font-size:31rpx;font-weight:700;margin-bottom:18rpx}.label{font-size:25rpx;margin:22rpx 0 12rpx;word-break:break-all}textarea,input{box-sizing:border-box;width:100%;padding:18rpx;background:#f5f7f2;border:1rpx solid #d9e1d6;border-radius:12rpx;font-size:25rpx}textarea{height:220rpx}input{height:78rpx}button{margin-top:22rpx;font-size:27rpx;background:#e9efe7;color:#254d3e;border-radius:14rpx}.primary{background:#214e40;color:#fff}.check{display:block;font-size:25rpx;line-height:1.7;margin-top:24rpx}.status{padding:24rpx;border-radius:16rpx;background:#fff0dc;color:#784e1f;word-break:break-all}.metric{font-size:56rpx;font-weight:700;margin:18rpx 0}.row{font-size:25rpx;line-height:1.8;margin-top:12rpx}
