page { background: #f6f5ee; color: #203c34; }
.oc-page { padding: 24rpx 24rpx 70rpx; }
.oc-page button::after { border: 0; }
.oc-page button { margin: 0; line-height: 1.5; font-size: 25rpx; border-radius: 16rpx; }
.oc-page button[disabled] { opacity: .4; }
.oc-page input, .oc-page textarea { width: 100%; box-sizing: border-box; background: #fffefa; border: 1rpx solid #d8dfd3; border-radius: 14rpx; font-size: 26rpx; color: #203c34; padding: 20rpx; }
.oc-page input { height: 84rpx; }.oc-page textarea { height: 170rpx; line-height: 1.7; }
.oc-hero { position: relative; padding: 46rpx 32rpx; background: #163e36; color: #f8f3e7; border-radius: 28rpx; }
.oc-eyebrow { font-size: 21rpx; color: #7e8c77; letter-spacing: 1rpx; }.oc-hero .oc-eyebrow { color: #d6bc83; }
.oc-hero-title { font-size: 45rpx; line-height: 1.4; font-weight: 600; margin: 24rpx 0 17rpx; letter-spacing: -1rpx; }
.oc-subtitle { font-size: 23rpx; color: #c7d4c8; }.oc-local { position: absolute; right: 25rpx; top: 32rpx; font-size: 18rpx; padding: 7rpx 13rpx; border: 1rpx solid #677c6f; border-radius: 25rpx; }
.oc-toolbar { display: flex; gap: 14rpx; margin: 28rpx 0 12rpx; }.oc-toolbar .oc-button { flex: 1; padding: 22rpx 12rpx; font-size: 23rpx; }
.oc-button { border: 1rpx solid #cfd8c9; background: #fffdf7; color: #163e36; padding: 22rpx 26rpx; font-weight: 600; }.oc-button.primary { background: #163e36; color: #fffaf0; border-color: #163e36; }
.oc-toolbar-hint, .oc-hint, .oc-footnote { font-size: 22rpx; line-height: 1.8; color: #7c8675; }.oc-toolbar-hint { margin-bottom: 24rpx; }.oc-footnote { margin: 28rpx 6rpx 0; }
.oc-feedback { margin-top: 22rpx; padding: 22rpx 26rpx; border-radius: 16rpx; border: 1rpx solid #b9cebc; background: #e7f1e7; color: #224633; font-size: 24rpx; line-height: 1.7; }.oc-feedback.is-error { border-color: #dab4a3; background: #fff1e9; color: #8a3929; }
.oc-panel { padding: 30rpx; background: #faf8f2; border: 1rpx solid #dedfd3; border-radius: 24rpx; margin-top: 24rpx; }
.oc-heading { display: flex; align-items: center; justify-content: space-between; gap: 15rpx; margin-bottom: 26rpx; }.oc-heading > view { font-size: 32rpx; font-weight: 600; }.oc-heading > text { font-size: 20rpx; color: #818b77; }
.oc-text { padding: 5rpx 0; background: transparent; color: #163e36; font-size: 23rpx !important; font-weight: 500; min-width: 0; }.danger { color: #a3533b !important; }
.oc-filters { display: flex; flex-direction: column; gap: 16rpx; }.oc-picker { border: 1rpx solid #d8dfd3; background: #fffefa; border-radius: 14rpx; font-size: 25rpx; padding: 22rpx 20rpx; display: flex; gap: 12rpx; align-items: center; justify-content: space-between; }
.oc-picker > text { color: #9b9f90; }.oc-filter-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 20rpx; }.oc-overdue-toggle { display: flex; align-items: center; gap: 7rpx; font-size: 24rpx; }.oc-overdue-toggle switch { transform: scale(.7); transform-origin: left center; width: 78rpx; }
.oc-copy { display: flex; gap: 26rpx; margin-top: 10rpx; }.oc-metrics { display: flex; border-top: 1rpx solid #dedfd3; margin-top: 25rpx; padding-top: 28rpx; }.oc-metrics > view { width: 25%; }.oc-metrics text { font-size: 22rpx; color: #7c8673; }.oc-metrics > view > view { font-size: 53rpx; font-weight: 600; margin-top: 10rpx; }.oc-metrics .oc-overdue-number > view { color: #a2573b; }
.oc-carry { background: #faf6e9; border: 1rpx solid #e2dbcb; border-radius: 20rpx; padding: 27rpx 30rpx; margin-top: 24rpx; }.oc-carry-title { display: flex; justify-content: space-between; font-size: 26rpx; font-weight: 500; margin-bottom: 7rpx; }.oc-carry-title > text:last-child { color: #998a66; font-size: 22rpx; }.oc-carry-description { margin: 24rpx 0 16rpx; }.oc-carry input { margin: 14rpx 0; }.oc-carry .oc-button { margin-top: 20rpx; }
.oc-empty { border: 1rpx dashed #ccd7c4; border-radius: 24rpx; text-align: center; margin: 28rpx 0; padding: 66rpx 30rpx; }.oc-empty > view { color: #516c4c; font-size: 31rpx; margin-bottom: 18rpx; }.oc-empty > text { color: #88917d; font-size: 23rpx; line-height: 1.9; }
.oc-task { background: #fffefa; border: 1rpx solid #dce1d7; padding: 30rpx; border-radius: 24rpx; margin-top: 24rpx; }.oc-task.task-overdue { border-top: 5rpx solid #b17c54; padding-top: 26rpx; }.oc-task-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 24rpx; }.oc-task-top > view { flex: 1; min-width: 0; }.oc-task-top .oc-text { flex-shrink: 0; }.oc-task-title { font-size: 32rpx; font-weight: 600; margin-top: 12rpx; line-height: 1.6; word-break: break-all; }
.oc-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 13rpx; font-size: 21rpx; color: #7d8674; margin-top: 22rpx; }.oc-status { padding: 7rpx 13rpx; border-radius: 9rpx; background: #eef0e8; color: #64705c; }.oc-status.complete { background: #e8f2e5; color: #236046; }.oc-status.active { background: #f6efda; color: #7c6232; }.oc-status.overdue { background: #f9eade; color: #9a452f; }
.oc-progress { height: 7rpx; border-radius: 5rpx; background: #edf0e6; margin: 27rpx 0; overflow: hidden; }.oc-progress > view { height: 100%; background: #78916e; }
.oc-person { margin-top: 20rpx; }.oc-person-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; gap: 16rpx; }.oc-person-top > text { font-size: 26rpx; font-weight: 500; word-break: break-all; }.oc-person-picker { background: #f0f3e9; color: #536e46; border-radius: 10rpx; padding: 14rpx 20rpx; font-size: 23rpx; white-space: nowrap; }.oc-person input { height: 70rpx; padding: 15rpx 18rpx; font-size: 23rpx; }
.oc-detail-toggle { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; border-top: 1rpx solid #eceee5; padding-top: 23rpx; margin-top: 27rpx; font-size: 23rpx; color: #627457; }.oc-detail-toggle > text:last-child { color: #8a947d; font-size: 20rpx; }
.oc-pdca { display: flex; flex-direction: column; gap: 26rpx; margin: 30rpx 0; }.oc-pdca > view { display: flex; gap: 24rpx; }.oc-letter { font-size: 38rpx; font-weight: 600; color: #a27b39; width: 40rpx; flex-shrink: 0; }.oc-pdca > view > view { flex: 1; min-width: 0; }.oc-pdca-label { color: #76876b; font-size: 21rpx; margin-bottom: 6rpx; }.oc-pdca > view > view > text { font-size: 25rpx; line-height: 1.8; white-space: pre-wrap; word-break: break-all; }
.oc-source-list { border-top: 1rpx solid #e7e8df; padding-top: 20rpx; }.oc-source-list > view { margin-bottom: 20rpx; font-size: 24rpx; line-height: 1.6; }.oc-source-date { font-size: 20rpx; color: #90997f; margin-left: 15rpx; }.oc-source-reference { display: block; margin-top: 7rpx; font-size: 22rpx; color: #849077; white-space: pre-wrap; word-break: break-all; }
.oc-editor { border-top: 5rpx solid #a27b39; }.oc-field { display: flex; flex-direction: column; gap: 12rpx; margin-top: 25rpx; }.oc-field > text { color: #6d7d62; font-size: 24rpx; }.oc-editor .oc-hint { margin-top: 16rpx; }.oc-source-heading { display: flex; justify-content: space-between; align-items: center; margin-top: 32rpx; font-size: 26rpx; }.oc-source-edit { background: #f0eee4; border-radius: 17rpx; padding: 22rpx; display: flex; flex-direction: column; gap: 17rpx; margin-top: 22rpx; }.oc-source-edit .oc-text { align-self: flex-start; }.oc-actions { display: flex; gap: 17rpx; margin-top: 32rpx; }.oc-actions .primary { flex: 1; }
.oc-rank-title { font-size: 26rpx; font-weight: 600; margin: 34rpx 0 15rpx; }.oc-rank-row { display: flex; gap: 12rpx; align-items: center; padding: 23rpx 0; border-bottom: 1rpx solid #e2e5d7; font-size: 23rpx; }.oc-rank-row > text:nth-child(1) { width: 34%; word-break: break-all; }.oc-rank-row > text:nth-child(2) { width: 28%; }.oc-rank-row > text:nth-child(3) { width: 22%; }.oc-rank-row > text:nth-child(4) { flex: 1; text-align: right; }.oc-rank-head { font-size: 19rpx; color: #8c967e; }.oc-rate { font-weight: 600; }.oc-rank-empty { padding: 20rpx 0; }
