{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hugetools.local/schemas/incentive-system.schema.json",
  "title": "HUGEtools Store Incentive System",
  "type": "object",
  "required": ["employees", "tasks", "records"],
  "properties": {
    "employees": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "role"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["店长", "后厨", "库管", "前厅"] }
        },
        "additionalProperties": false
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "role", "ownerId", "cycle", "dueTime", "basePoints", "active"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "role": { "type": "string", "enum": ["店长", "后厨", "库管", "前厅"] },
          "ownerId": { "type": "string" },
          "cycle": { "type": "string", "enum": ["daily", "weekly", "monthly"] },
          "dueTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
          "dueWeekday": { "type": "integer", "minimum": 1, "maximum": 7 },
          "dueMonthDay": { "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 31 }, { "const": "last" }] },
          "basePoints": { "type": "integer", "minimum": 1, "maximum": 200 },
          "description": { "type": "string" },
          "qualityStandard": { "type": "string" },
          "active": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "taskId", "employeeId", "role", "periodKey", "dueAt", "status", "qualityScore", "omitted", "score", "points"],
        "properties": {
          "id": { "type": "string" },
          "taskId": { "type": "string" },
          "employeeId": { "type": "string" },
          "role": { "type": "string", "enum": ["店长", "后厨", "库管", "前厅"] },
          "periodKey": { "type": "string" },
          "dueAt": { "type": "string", "format": "date-time" },
          "completedAt": { "type": ["string", "null"], "format": "date-time" },
          "status": { "type": "string", "enum": ["pending", "completed", "missed"] },
          "qualityScore": { "type": "integer", "minimum": 0, "maximum": 100 },
          "omitted": { "type": "boolean" },
          "score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "points": { "type": "integer", "minimum": 0 },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
