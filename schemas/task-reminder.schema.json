{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hugetools.local/schemas/task-reminder.schema.json",
  "title": "HUGEtools Task Reminder",
  "type": "object",
  "required": ["id", "title", "role", "enabled", "schedule", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "string", "minLength": 6 },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "role": { "type": "string", "minLength": 1, "maxLength": 40 },
    "description": { "type": "string", "maxLength": 600 },
    "enabled": { "type": "boolean" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "nextDueAt": { "type": ["string", "null"], "format": "date-time" },
    "lastTriggeredAt": { "type": ["string", "null"], "format": "date-time" },
    "completedHistory": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["title", "role", "dueAt", "completedAt"],
        "properties": {
          "title": { "type": "string" },
          "role": { "type": "string" },
          "dueAt": { "type": ["string", "null"], "format": "date-time" },
          "completedAt": { "type": "string", "format": "date-time" },
          "note": { "type": "string" }
        }
      }
    },
    "schedule": {
      "type": "object",
      "required": ["type", "time"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["once", "daily", "weekly", "monthly_date", "monthly_last", "custom_interval"]
        },
        "time": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "date": { "type": "string", "format": "date" },
        "weekdays": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 7 },
          "uniqueItems": true
        },
        "monthDay": { "type": "integer", "minimum": 1, "maximum": 31 },
        "intervalValue": { "type": "integer", "minimum": 1, "maximum": 365 },
        "intervalUnit": { "type": "string", "enum": ["hours", "days", "weeks", "months"] },
        "startDate": { "type": "string", "format": "date" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "once" } } },
          "then": { "required": ["date"] }
        },
        {
          "if": { "properties": { "type": { "const": "weekly" } } },
          "then": { "required": ["weekdays"] }
        },
        {
          "if": { "properties": { "type": { "const": "monthly_date" } } },
          "then": { "required": ["monthDay"] }
        },
        {
          "if": { "properties": { "type": { "const": "custom_interval" } } },
          "then": { "required": ["intervalValue", "intervalUnit"] }
        }
      ]
    }
  },
  "additionalProperties": false
}
